{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/especialidades", "destination": "/#servicos", "permanent": true },
    { "source": "/nossa-equipe", "destination": "/sobre-nos/#equipe", "permanent": true },
    { "source": "/politica-de-privacidade-2", "destination": "/politica-de-privacidade/", "permanent": true },
    { "source": "/wp-:area(admin|login|content|includes)/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-:area(admin|login|content|includes)", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(woff2|png|jpg|webp|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
